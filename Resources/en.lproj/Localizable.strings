/* ---- About pane ---- */
"about.tagline" = "Fixes text typed in the wrong keyboard layout. English, Russian and Kazakh.";
"about.version" = "Version %@";
"about.copyright" = "Copyright © 2026 Tilqos contributors. MIT License.";
"about.privacy.header" = "Privacy";
"about.privacy.intro" = "To notice a wrong layout, Tilqos has to watch every key you press. This is exactly what it does with them.";
"about.privacy.memory" = "What you type is kept in memory only. The buffer is cleared after at most 5 seconds without typing, when you switch apps, at Return, Tab, Esc and similar keys, in password fields, and when the Mac locks or goes to sleep.";
"about.privacy.undo" = "“Undo” keeps only your latest corrections, in memory, for at most 2 minutes. They are wiped when you switch apps or windows (Tilqos’s own Settings window included), lock or sleep the Mac, or quit Tilqos.";
"about.privacy.clipboard" = "The clipboard is used only by actions that need it, and its previous contents are put back afterwards. If it holds concealed or temporary content, such as from a password manager, Tilqos does not read it and the action does nothing (with a beep). Text over 10,000 characters is ignored.";
"about.privacy.secure" = "Nothing is read or logged while macOS secure input is active, which covers most password fields. Password managers and login windows are always excluded.";
"about.privacy.log" = "The log never contains typed text, clipboard contents or window titles.";
"about.privacy.storage" = "Stored on this Mac: your settings, per-app rules, the exception words you add (as plain text) and learned words (as salted 64-bit hashes, which is not encryption: someone who can read the file could guess short, common words).";
"about.privacy.network" = "Tilqos has no network access, no telemetry and no updater. To get a new version, download it yourself.";
"about.licenses.header" = "Licenses";
"about.licenses.text" = "Tilqos is open-source software under the MIT License. Its language data is derived from third-party dictionaries that come with their own licenses and notices.";
"about.licenses.mit" = "MIT License";
"about.licenses.notices" = "Third-party notices";
"about.licenses.folder" = "Show all license files";
"about.licenses.missing" = "The license files were not found next to the app. They are in the project’s source repository.";

